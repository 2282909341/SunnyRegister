# SunnyRegister 本地与 Docker Compose 通用配置模板
# 复制为 .env 后按需修改。

# Web 服务监听
SUNNYREGISTER_BIND=0.0.0.0
SUNNYREGISTER_PORT=8000
SUNNYREGISTER_TAG=latest
TZ=Asia/Shanghai
SUNNY_TIMEZONE=Asia/Shanghai
SUNNY_HEALTHCHECK_ENABLED=true
SUNNY_HEALTHCHECK_TIME=06:00
SUNNY_HEALTHCHECK_CONCURRENCY=2
SUNNY_HEALTHCHECK_BATCH_SIZE=50
OUTLOOK_IMAP_DIRECT_FIRST=false
OUTLOOK_IMAP_PROXY=
XBOVO_ICLOUD_MAX_CONCURRENCY=3
XBOVO_ICLOUD_POOL_RETRIES=4
XBOVO_ICLOUD_QUEUE_TIMEOUT=120
XBOVO_ICLOUD_LONG_POLL_SECONDS=10

# 管理员账号。留空 ADMIN_PASSWORD 时首次启动会自动生成密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
APP_PASSWORD=

# PostgreSQL（必需）。Docker Compose 会使用 POSTGRES_* 配置组装容器内连接串。
POSTGRES_DB=sunnyregister
POSTGRES_USER=sunnyregister
POSTGRES_PASSWORD=sunnyregister
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
# Windows / Linux 原生运行时使用。生产环境建议 sslmode=require 或 verify-full。
DATABASE_URL=postgresql://sunnyregister:sunnyregister@127.0.0.1:5432/sunnyregister?sslmode=disable
SUNNY_DB_MAX_OPEN_CONNS=20
SUNNY_DB_MAX_IDLE_CONNS=5

# Python Worker
PYTHON_WORKER_URL=http://127.0.0.1:8765
PYTHON_WORKER_TOKEN=
PYTHON_TASK_TYPES=sunny_register,sunny_login,sunny_refresh_session,sunny_acquire_rt,sunny_rebind

# 代理链（中继）。住宅代理网关无法从本机直连时，先接入本机中继再转发到住宅代理：
# client -> 中继 -> 住宅代理 -> 目标。Go 后端与 Python Worker 共用该变量。
# 默认 socks5h://127.0.0.1:7890（FlClash 等 mixed 端口同时支持 HTTP/SOCKS5，
# 但 libcurl 的 pre-proxy 只接受 SOCKS，因此必须写 socks5h://）。
# 设为 off/direct/none/0 可关闭中继，恢复直连住宅代理。
SUNNY_PROXY_RELAY=socks5h://127.0.0.1:7890

# 图形服务默认关闭以降低空闲资源占用；后台 Camoufox 无需 Xvfb。只有持续使用可视浏览器/noVNC 时才启用。
ENABLE_XVFB=false
ENABLE_NOVNC=false
WORKER_DISPLAY=:99
NOVNC_BIND=127.0.0.1
NOVNC_PORT=6080
XVFB_WHD=1600x900x24
WORKER_SHM_SIZE=1gb

# 可选：也可以在前端“反代配置”中填写。
SUB2API_BASE_URL=
SUB2API_ADMIN_TOKEN=
SUB2API_AUTH_HEADER=x-api-key
SUB2API_GROUP_ID=
SUB2API_GROUP_NAME=
